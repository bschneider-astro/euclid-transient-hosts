# figure.dpi: 300

# Lines
lines.linewidth: 2.0
lines.markersize: 9
hatch.linewidth: 0.25

patch.antialiased: True

# Axes
axes.titlesize: large
axes.labelsize: large

# Ticks
xtick.top: True
xtick.bottom: True
xtick.major.size: 10.0
xtick.minor.size: 5.0
xtick.major.width: 0.5
xtick.minor.width: 0.5
xtick.direction: in
xtick.minor.visible: True
xtick.major.top: True
xtick.major.bottom: True
xtick.minor.top: True
xtick.minor.bottom: True
xtick.major.pad: 5.0
xtick.minor.pad: 5.0
xtick.labelsize: large

ytick.left: True
ytick.right: True
ytick.major.size: 10.0
ytick.minor.size: 5.0
ytick.major.width: 0.5
ytick.minor.width: 0.5
ytick.direction: in
ytick.minor.visible: True
ytick.major.left: True
ytick.major.right: True
ytick.minor.left: True
ytick.minor.right: True
ytick.major.pad: 5.0
ytick.minor.pad: 5.0
ytick.labelsize: large

# Legend
legend.frameon: False
legend.fontsize: 13
legend.handletextpad: 0.4
legend.labelspacing: 0.35

# Figure size
# figure.figsize: 5.0, 3.0
figure.subplot.left: 0.125
figure.subplot.bottom: 0.175
figure.subplot.top: 0.95
figure.subplot.right: 0.95
figure.autolayout: True

# Fonts
# mathtext.fontset: stix
# font.family: STIXGeneral
font.family: sans-serif
font.weight: normal
font.size : 14

# Colors & Lines
axes.prop_cycle: cycler(color=['xkcd:black', 'xkcd:blue', 'xkcd:red', 'xkcd:deep green', 'xkcd:magenta', 'xkcd:orange', 'xkcd:gray'])
#linestyle=['-', '--', ':', '-.', (0, (6.4, 1.6, 1, 1.6, 1, 1.6)), (0, (1, 1.6, 3.2, 1.6, 3.2, 1.6))])